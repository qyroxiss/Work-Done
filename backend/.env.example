# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# 0.0.0.0 = listen on all network interfaces (needed for other office PCs)
HOST=0.0.0.0
NODE_ENV=development

# --- SQL Server ---
# Named instance:  DB_SERVER=localhost\SQL2022   (requires SQL Server Browser service)
# Default/fixed port: DB_SERVER=localhost and DB_PORT=1433
DB_SERVER=localhost
DB_PORT=
DB_DATABASE=WorkDoneDB
DB_USER=workdone_app
DB_PASSWORD=YOUR_SECRET
DB_ENCRYPT=true
# Only set true in development with a self-signed SQL certificate. Keep false in production
# and install a trusted certificate on SQL Server instead.
DB_TRUST_SERVER_CERTIFICATE=false

# --- Sessions ---
# Log out after this many minutes of inactivity
SESSION_IDLE_MINUTES=30
# Maximum session lifetime regardless of activity
SESSION_MAX_HOURS=12
# true when the app is served over HTTPS (required in production with HTTPS)
COOKIE_SECURE=false

# --- Optional HTTPS (serve the app directly over TLS on the LAN) ---
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Set to 1 if running behind a reverse proxy (IIS/nginx) so client IPs are logged correctly
TRUST_PROXY=0
