# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# 0.0.0.0 = listen on all network interfaces (needed for other office PCs)
HOST=0.0.0.0
NODE_ENV=development

# --- PostgreSQL (14 or newer) ---
# Left empty, the setup wizard asks for it and saves it here.
#   Local:  postgres://workdone:YOUR_SECRET@localhost:5432/workdone
#   Neon:   postgres://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
# The user must be allowed to create tables in the database (normally its owner).
DATABASE_URL=
# Connections this server keeps open (lower it on serverless hosts)
DB_POOL_SIZE=10

# --- Serverless hosting (Vercel sets VERCEL=1 and these switch on by themselves) ---
# REALTIME_MODE=poll       live events through the database (to test serverless mode elsewhere)
# UPLOAD_LIMIT_MB=4        largest work file (chat files are capped at 10 MB, or this if lower)
# CRON_SECRET=             protects GET /api/cron/daily (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>")

# --- Setup from another computer (optional) ---
# Setup and client management normally work only on the server computer itself (localhost).
# Set a long random key to allow them from anywhere after entering this key (needed on cloud hosts).
SETUP_KEY=

# --- Sessions ---
# Log out after this many minutes of inactivity
SESSION_IDLE_MINUTES=30
# Maximum session lifetime regardless of activity
SESSION_MAX_HOURS=12
# true when the app is served over HTTPS (required in production with HTTPS)
COOKIE_SECURE=false

# --- Optional HTTPS (serve the app directly over TLS on the LAN) ---
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Set to 1 if running behind a reverse proxy (IIS/nginx) so client IPs are logged correctly
TRUST_PROXY=0
