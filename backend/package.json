{
  "name": "workdone-backend",
  "version": "1.0.0",
  "description": "WorkDone Management System - Express API",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/embed-sql.mjs && tsx watch src/server.ts",
    "build": "node scripts/embed-sql.mjs && tsc -p tsconfig.json && node scripts/bundle-vercel.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "db:setup": "tsx src/scripts/setupDb.ts",
    "db:seed": "tsx src/scripts/setupDb.ts --seed-only",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "add-client": "tsx src/scripts/addClient.ts",
    "import:sqlserver": "tsx src/scripts/importFromSqlServer.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/mssql": "^9.1.11",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "mssql": "^11.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
